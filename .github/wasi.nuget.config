<configuration>
  <packageSources>
    <clear />
    <add key="runtime-pack" value="../runtime-pack" />
    <add key="dotnet12" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet12/nuget/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="runtime-pack">
      <package pattern="Microsoft.NETCore.App.Runtime.NativeAOT.wasi-wasm" />
    </packageSource>
    <packageSource key="dotnet12">
      <package pattern="*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
